; Map-record layout established from the complete Banks $29-$2F record set
; and the ROM0 map-prefix loader at $28A0.
DEF MAP_RECORD_HEADER_SIZE EQU 32
DEF MAP_RECORD_BODY_LENGTH_OFFSET EQU 2
DEF MAP_RECORD_CHECKSUM_OFFSET EQU 4
DEF MAP_RECORD_BODY_OFFSET EQU MAP_RECORD_HEADER_SIZE
; Retail names occupy eight contiguous bytes. the current source reserves the final,
; otherwise-zero header byte as a backward-compatible ninth-character sidecar.
DEF MAP_RECORD_NAME_LEGACY_SIZE EQU 8
DEF MAP_RECORD_NAME_SIZE   EQU 8
DEF MAP_RECORD_NAME_EXTRA_HEADER_OFFSET EQU MAP_RECORD_HEADER_SIZE - 1
DEF MAP_RECORD_NAME_LOGICAL_SIZE EQU MAP_RECORD_NAME_SIZE + 1
DEF MAP_RECORD_NAME_TERMINATED_SIZE EQU MAP_RECORD_NAME_LOGICAL_SIZE + 1

; Temporary 9-character render buffers contain the retail 8-byte field,
; the header-sidecar ninth character, and a borrowed zero terminator.
DEF MAP_NAME_RENDER_SCRATCH_SIZE EQU MAP_RECORD_NAME_TERMINATED_SIZE
DEF MAP_NAME_RENDER_EXTRA_OFFSET EQU MAP_RECORD_NAME_SIZE
DEF MAP_NAME_RENDER_TERMINATOR_OFFSET EQU MAP_RECORD_NAME_LOGICAL_SIZE
DEF MAP_RECORD_FIELD_COUNT EQU 4
DEF MAP_RECORD_PARAMETERS_OFFSET EQU MAP_RECORD_HEADER_SIZE + MAP_RECORD_NAME_SIZE
DEF MAP_RECORD_PARAMETER_0_OFFSET EQU MAP_RECORD_PARAMETERS_OFFSET + 0
DEF MAP_RECORD_PARAMETER_1_OFFSET EQU MAP_RECORD_PARAMETERS_OFFSET + 1
DEF MAP_RECORD_PARAMETER_2_OFFSET EQU MAP_RECORD_PARAMETERS_OFFSET + 2
DEF MAP_RECORD_PARAMETER_3_OFFSET EQU MAP_RECORD_PARAMETERS_OFFSET + 3
DEF MAP_RECORD_PREFIX_SIZE EQU MAP_RECORD_HEADER_SIZE + MAP_RECORD_NAME_SIZE + MAP_RECORD_FIELD_COUNT + 2

