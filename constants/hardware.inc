; Cartridge banking registers.
; These names describe the register role without assuming a more specific MBC subtype.
DEF rRAMG  EQU $0000
DEF rROMB0 EQU $2000
DEF rRAMB  EQU $4000

; Game Boy hardware registers used by the sourced engine.
; Names follow the established RGBDS/pret rXXXX convention.

; Joypad / serial / timer
DEF rP1   EQU $FF00
DEF rSC   EQU $FF02
DEF rTIMA EQU $FF05
DEF rTMA  EQU $FF06
DEF rTAC  EQU $FF07
DEF rIF   EQU $FF0F

; P1 selector values
DEF P1F_GET_DPAD EQU $20
DEF P1F_GET_BUTTONS EQU $10
DEF P1F_GET_NONE EQU $30
DEF JOYPAD_BUTTONS_MASK EQU $0f
DEF JOYPAD_DPAD_MASK EQU $f0

; Serial / timer control values
DEF SC_TRANSFER_START_MASK EQU $80
DEF IF_CLEAR_TIMER_MASK EQU $1b
DEF TAC_65536_HZ EQU $02
DEF TAC_ENABLE_65536_HZ EQU $06
DEF TAC_16384_HZ EQU $03
DEF TAC_ENABLE_16384_HZ EQU $07

; Audio

DEF rNR10 EQU $FF10
DEF rNR11 EQU $FF11
DEF rNR12 EQU $FF12
